        },
        "messages": {
          "values": [
            {
              "content": "=Extract the user's information from the following Jira ticket description. You must respond with ONLY a raw JSON object, no explanation, no markdown, no code fences. Just the JSON object itself.\n\nUse these exact keys: \"firstName\", \"lastName\", \"email\", \"location\"\n\nIf any field cannot be found, use an empty string.\n\nJira ticket description:\n{{ $json[\"Description\"] }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
