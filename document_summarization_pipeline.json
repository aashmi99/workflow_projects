    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const text = item.json.output?.[0]?.content?.[0]?.text || '';\n  \n  const clean = text\n    .replace(/```json\\n?/gi, '')\n    .replace(/```\\n?/gi, '')\n    .trim();\n\n  const data = JSON.parse(clean);\n\n  return {\n    json: {\n      \"Summary\": data.summary || '',\n      \"Key Points\": data.key_points || '',\n      \"Category\": data.category || ''\n    }\n  };\n});"
      },
